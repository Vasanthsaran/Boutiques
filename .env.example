# ───────── Core ─────────
NODE_ENV=development            # production in prod
PORT=4000
# Public URL of the site (used for CORS/CSRF origin checks and links in emails).
# In production with the bundled server this is your site URL, e.g. https://svssboutique.in
APP_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx…)
TRUST_PROXY=0

# PostgreSQL connection string (REQUIRED)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/svss?schema=public

# Long random string (REQUIRED). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# ───────── Media storage ─────────
# "s3" is REQUIRED in production (any S3-compatible service: AWS S3, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO). "local" is for development only.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com (leave blank for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false       # true for MinIO
# Optional: public CDN/bucket URL for public images. If blank, media is streamed through the API.
S3_PUBLIC_BASE_URL=

# ───────── Email (optional) ─────────
# Without SMTP, password-reset and notification emails are NOT sent; communication
# stays in-app and admins can generate a reset link from Admin → Customers.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SVSS Boutique <no-reply@example.com>"
# Address that receives new enquiry/appointment alerts (optional)
ADMIN_NOTIFY_EMAIL=
# Require customers to verify email before booking/enquiring (only effective when SMTP is set)
REQUIRE_EMAIL_VERIFICATION=false

# ───────── First admin (used by `npm run create-admin`) ─────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
